  <xacro:tof_sensor name="tof_2317" parent="upper_arm_link" xyz="0.0789622168 0.000230380915 0.100806622" rpy="0 0.000467987944 0" max_range="3" rate="15"/>
  <xacro:tof_sensor name="tof_2658" parent="forearm_link" xyz="0.045 0 -0.02" rpy="0 -0 0" max_range="3" rate="15"/>
