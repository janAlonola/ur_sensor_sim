  <xacro:tof_sensor name="tof_884" parent="forearm_link" xyz="0.0596339717 -0.010472714 0.018138601" rpy="0.18569134 0.0436235937 -0.18569134" max_range="3" rate="15"/>
  <xacro:tof_sensor name="tof_1294" parent="upper_arm_link" xyz="-0.669498203 -0.0286533387 0.145284609" rpy="2.66378078 -0.000488267479 -2.66378078" max_range="3" rate="15"/>
  <xacro:tof_sensor name="tof_1440" parent="upper_arm_link" xyz="-0.576993606 -0.0522085806 0.125874523" rpy="0.930356647 0.000830065328 -0.930356647" max_range="3" rate="15"/>
