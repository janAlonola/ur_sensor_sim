  <xacro:tof_sensor name="tof_855" parent="upper_arm_link" xyz="-0.074099216 0.02876944 0.261470129" rpy="-2.75262518 -0.455014437 2.75262518" max_range="3" rate="15"/>
  <xacro:tof_sensor name="tof_382" parent="shoulder_link" xyz="-0.0775268386 0.0196195045 0.0065268972" rpy="-2.89651025 -0.00016740271 2.89651025" max_range="3" rate="15"/>
  <xacro:tof_sensor name="tof_824" parent="upper_arm_link" xyz="-0.0974867517 -0.0303739902 0.107156421" rpy="2.85510972 0.676442372 -2.85510972" max_range="3" rate="15"/>
  <xacro:tof_sensor name="tof_843" parent="upper_arm_link" xyz="-0.0848169589 -0.0703246425 0.214098477" rpy="1.56080279 -0.527831004 -1.56080279" max_range="3" rate="15"/>
  <xacro:tof_sensor name="tof_367" parent="forearm_link" xyz="0.0511376884 0.00841083682 0.0379033495" rpy="2.97157426 0.319294223 -2.97157426" max_range="3" rate="15"/>
  <xacro:tof_sensor name="tof_285" parent="forearm_link" xyz="-0.0629999515 -0.0170360357 0.0223235103" rpy="0 -0 0" max_range="3" rate="15"/>
  <xacro:tof_sensor name="tof_314" parent="forearm_link" xyz="-0.0200473487 -0.0609103016 0.0256578645" rpy="1.71910654 0.133046418 -1.71910654" max_range="3" rate="15"/>
  <xacro:tof_sensor name="tof_860" parent="upper_arm_link" xyz="-0.0675926768 -0.0606059308 0.12423312" rpy="1.50052121 0.732632189 -1.50052121" max_range="3" rate="15"/>

  <!-- Gazebo ROS 2 Control -->
  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <parameters>$(find ur_simulation_gazebo)/config/ur_controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
