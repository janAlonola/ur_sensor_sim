  <xacro:tof_sensor name="tof_2975" parent="forearm_link" xyz="-0.020013442 -0.043871756 -0.02" rpy="1.7951958 0.261799388 -1.7951958" max_range="3" rate="15"/>
  <xacro:tof_sensor name="tof_2976" parent="forearm_link" xyz="0.0180570411 -0.0351824167 -0.02" rpy="0.897597901 0.261799388 -0.897597901" max_range="3" rate="15"/>
  <xacro:tof_sensor name="tof_2977" parent="forearm_link" xyz="-0.01 0 -0.02" rpy="3.14159265 1.57079633 0" max_range="3" rate="15"/>
  <xacro:tof_sensor name="tof_3178" parent="upper_arm_link" xyz="0.055 0 0.27" rpy="0 -0.174532925 0" max_range="3" rate="15"/>
  <xacro:tof_sensor name="tof_3179" parent="upper_arm_link" xyz="0.0342919391 0.0430007315 0.27" rpy="-0.897597901 -0.174532925 0.897597901" max_range="3" rate="15"/>
  <xacro:tof_sensor name="tof_3180" parent="upper_arm_link" xyz="-0.0122386514 0.0536210352 0.27" rpy="-1.7951958 -0.174532925 1.7951958" max_range="3" rate="15"/>
  <xacro:tof_sensor name="tof_3181" parent="upper_arm_link" xyz="-0.0495532877 0.0238636057 0.27" rpy="-2.6927937 -0.174532925 2.6927937" max_range="3" rate="15"/>
  <xacro:tof_sensor name="tof_3182" parent="upper_arm_link" xyz="-0.0495532877 -0.0238636057 0.27" rpy="2.6927937 -0.174532925 -2.6927937" max_range="3" rate="15"/>
