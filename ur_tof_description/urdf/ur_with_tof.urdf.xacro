  <xacro:tof_sensor name="tof_3097" parent="upper_arm_link" xyz="-0.11 0.038890873 0.137109127" rpy="-2.75399597 0.361367124 2.75399597" max_range="3" rate="15"/>

  <!-- Gazebo ROS 2 Control -->
  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <parameters>$(find ur_simulation_gazebo)/config/ur_controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
