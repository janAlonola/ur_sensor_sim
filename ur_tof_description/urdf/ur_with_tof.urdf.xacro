  <xacro:tof_sensor name="tof_2629" parent="wrist_3_link" xyz="-0.00089319204 0.0489677203 -0.0149495719" rpy="-1.61954983 -0.00402538235 1.61954983" max_range="3" rate="15"/>
  <xacro:tof_sensor name="tof_2658" parent="forearm_link" xyz="-0.1 0.05 0.048" rpy="-1.57079633 -6.123234e-17 1.57079633" max_range="3" rate="15"/>
  <xacro:tof_sensor name="tof_2659" parent="forearm_link" xyz="-0.1 0.0311744901 0.0870915741" rpy="-1.57079633 -0.897597901 1.57079633" max_range="3" rate="15"/>
  <xacro:tof_sensor name="tof_2660" parent="forearm_link" xyz="-0.1 -0.0111260467 0.0967463956" rpy="1.57079633 -1.34639685 -1.57079633" max_range="3" rate="15"/>
  <xacro:tof_sensor name="tof_2661" parent="forearm_link" xyz="-0.1 -0.0450484434 0.069694187" rpy="1.57079633 -0.448798951 -1.57079633" max_range="3" rate="15"/>
  <xacro:tof_sensor name="tof_2662" parent="forearm_link" xyz="-0.1 -0.0450484434 0.026305813" rpy="1.57079633 0.448798951 -1.57079633" max_range="3" rate="15"/>
