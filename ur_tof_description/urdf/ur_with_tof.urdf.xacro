  <xacro:tof_sensor name="tof_1547" parent="upper_arm_link" xyz="-0.4949504 -0.0471593534 0.140566758" rpy="1.57079622 0.654407312 -1.57079622" max_range="3" rate="15"/>
  <xacro:tof_sensor name="tof_1752" parent="upper_arm_link" xyz="-0.282970502 0.00949112356 0.234149061" rpy="-1.57079735 -1.43987537 1.57079735" max_range="3" rate="15"/>
  <xacro:tof_sensor name="tof_1779" parent="upper_arm_link" xyz="-0.248309299 -0.0238871566 0.122029709" rpy="1.57079566 1.17823992 -1.57079566" max_range="3" rate="15"/>
  <xacro:tof_sensor name="tof_1829" parent="upper_arm_link" xyz="-0.197523965 -0.0235578 0.229988559" rpy="1.57079633 -1.17821645 -1.57079633" max_range="3" rate="15"/>
  <xacro:tof_sensor name="tof_1923" parent="upper_arm_link" xyz="-0.101987461 0.0282577366 0.123464329" rpy="-2.87901434 0.442262117 2.87901434" max_range="3" rate="15"/>
  <xacro:tof_sensor name="tof_1930" parent="upper_arm_link" xyz="-0.101416039 0.0290004968 0.229393058" rpy="-2.88515969 -0.416228119 2.88515969" max_range="3" rate="15"/>
