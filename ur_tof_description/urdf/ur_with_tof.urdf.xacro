  <xacro:tof_sensor name="tof_909" parent="wrist_3_link" xyz="-0.0202890502 0.0422380044 -0.0085393916" rpy="-2.03053878 -0.515230557 2.03053878" max_range="3" rate="15"/>

  <!-- Gazebo ROS 2 Control -->
  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <parameters>$(find ur_simulation_gazebo)/config/ur_controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
