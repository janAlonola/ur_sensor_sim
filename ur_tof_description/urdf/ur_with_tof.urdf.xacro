  <xacro:tof_sensor name="tof_1471" parent="upper_arm_link" xyz="-0.553657151 0.00163022252 0.24680427" rpy="0.0460841551 -0.725905132 -0.0460841551" max_range="3" rate="15"/>
  <xacro:tof_sensor name="tof_1921" parent="upper_arm_link" xyz="-0.102701822 0.00713650376 0.118170772" rpy="-3.1301201 0.476078417 3.1301201" max_range="3" rate="15"/>
