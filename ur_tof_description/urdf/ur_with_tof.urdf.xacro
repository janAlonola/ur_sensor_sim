  <xacro:tof_sensor name="tof_550" parent="upper_arm_link" xyz="-0.415562072 0.0460591286 0.139132657" rpy="-1.57079622 0.654407312 1.57079622" max_range="3" rate="15"/>
  <xacro:tof_sensor name="tof_648" parent="upper_arm_link" xyz="-0.177971058 0.0104599772 0.117879706" rpy="-1.57079571 1.35255402 1.57079571" max_range="3" rate="15"/>
  <xacro:tof_sensor name="tof_653" parent="upper_arm_link" xyz="-0.161349689 -0.0059242922 0.234618739" rpy="1.57079738 -1.43987537 -1.57079738" max_range="3" rate="15"/>
  <xacro:tof_sensor name="tof_683" parent="upper_arm_link" xyz="-0.100345182 -0.00470184188 0.245660619" rpy="3.10615903 -0.249208669 -3.10615903" max_range="3" rate="15"/>
  <xacro:tof_sensor name="tof_684" parent="upper_arm_link" xyz="-0.0974867517 -0.0303739902 0.107156421" rpy="2.85510972 0.676442372 -2.85510972" max_range="3" rate="15"/>
  <xacro:tof_sensor name="tof_687" parent="upper_arm_link" xyz="-0.0942443385 -0.0764470379 0.190000498" rpy="2.20080608 -0.19930768 -2.20080608" max_range="3" rate="15"/>
  <xacro:tof_sensor name="tof_700" parent="upper_arm_link" xyz="-0.0730162117 -0.0347787429 0.104986775" rpy="2.68375574 -0.00305712448 -2.68375574" max_range="3" rate="15"/>
  <xacro:tof_sensor name="tof_702" parent="upper_arm_link" xyz="-0.0695129221 0.0412793084 0.088622935" rpy="-2.63002488 -1.14625598e-16 2.63002488" max_range="3" rate="15"/>
  <xacro:tof_sensor name="tof_812" parent="wrist_1_link" xyz="-0.0384193164 0.0579681433 -0.0010541316" rpy="-1.815009 -0.0932017747 1.815009" max_range="3" rate="15"/>

  <!-- Gazebo ROS 2 Control -->
  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <parameters>$(find ur_simulation_gazebo)/config/ur_controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
