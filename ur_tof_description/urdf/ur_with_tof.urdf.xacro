  <xacro:tof_sensor name="tof_371" parent="forearm_link" xyz="0.0588476797 -0.0173048258 0.060772438" rpy="0.259921877 -2.8024683e-05 -0.259921877" max_range="3" rate="15"/>
  <xacro:tof_sensor name="tof_1128" parent="wrist_3_link" xyz="0.00622733081 0.0391464409 -0.0017324255" rpy="-1.31671291 -1.45353237 1.31671291" max_range="3" rate="15"/>
