  <xacro:tof_sensor name="tof_2664" parent="forearm_link" xyz="-0.1 0.0311744901 0.00890842588" rpy="-1.57079633 0.897597901 1.57079633" max_range="3" rate="15"/>

  <!-- Gazebo ROS 2 Control -->
  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <parameters>$(find ur_simulation_gazebo)/config/ur_controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
